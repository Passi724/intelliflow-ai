APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_COLLECTION=intelliflow-documents

# POST /api/chat (RAG answer generation) can use either:
#  - "ollama" (default): a local model served by Ollama, free, no API key.
#    Install Ollama (https://ollama.com) and run `ollama pull llama3.2:3b`.
#  - "groq": a hosted model on Groq's free tier. Used in deployment, since
#    Ollama needs more RAM/CPU than most free hosting tiers provide.
APP_LLM_PROVIDER=ollama

APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=llama3.2:3b

APP_GROQ_API_KEY=
APP_GROQ_MODEL=llama-3.1-8b-instant
