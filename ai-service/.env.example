APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_COLLECTION=intelliflow-documents

# POST /api/chat (RAG answer generation) uses a local model served by Ollama —
# free, no API key. Install Ollama (https://ollama.com) and run
# `ollama pull llama3.2:3b`, or point these at a different local model/port.
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=llama3.2:3b
